NODE_ENV=development
PORT=3001
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Use PostgreSQL locally, or replace this with an RDS PostgreSQL URL.
# Percent-encode special characters in usernames and passwords.
# Configure TLS using DB_SSL below; do not add SSL query parameters to the URL.
DATABASE_URL=postgresql://todo:localtodo@127.0.0.1:5432/todo_app
DB_SSL=false
# RDS production settings: DB_SSL=true and a path to the AWS RDS CA bundle.
# DB_SSL_CA_PATH=/app/certs/global-bundle.pem
DB_POOL_MAX=10
# Set to 1 only when the API is behind one trusted reverse proxy / AWS ALB.
TRUST_PROXY_HOPS=0
# Applies all pending migrations on startup. Disable if your deployment runs them separately.
RUN_MIGRATIONS=true
